<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <RollForward>Major</RollForward>
    <DefineConstants Condition="'$(ComponentMemoSmoke)' == 'true'">$(DefineConstants);MEMO</DefineConstants>
    <OtherFlags>$(OtherFlags) --reflectionfree</OtherFlags>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Platform.fs" />
    <Compile Include="Program.fs" Condition="'$(ComponentSizeSmoke)' != 'true'" />
    <Compile Include="SizeSmoke.fs" Condition="'$(ComponentSizeSmoke)' == 'true'" />
    <PackageReference Include="FSharp.Core" VersionOverride="9.0.300" />
    <ProjectReference Include="../Fabulous/Fabulous.fsproj" Condition="'$(FabulousAssembly)' == ''" />
    <Reference Include="Fabulous" Condition="'$(FabulousAssembly)' != ''">
      <HintPath>$(FabulousAssembly)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
